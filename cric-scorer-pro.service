[Unit]
Description=Cric Scorer Pro Enterprise Server
After=network.target

[Service]
Type=simple
User=node
Group=node
WorkingDirectory=/opt/cric-scorer-pro/Cric-Scorer-Pro-main
Environment=NODE_ENV=production
Environment=PORT=3000
Environment=HOST=0.0.0.0
ExecStart=/usr/bin/node server.js
Restart=on-failure
RestartSec=5
# Security limits
LimitNOFILE=65535
NoNewPrivileges=yes
PrivateTmp=yes
ProtectSystem=full

[Install]
WantedBy=multi-user.target
